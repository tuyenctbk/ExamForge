rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // Validation Helper: UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
             data.totalReviewed is int && data.totalReviewed >= 0 && data.totalReviewed <= 1000000 &&
             (!('lastStudyDayKey' in data) || (data.lastStudyDayKey is string && data.lastStudyDayKey.size() <= 16)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // Validation Helper: StudyDeck
    function isValidStudyDeck(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.description is string && data.description.size() <= 400 &&
             data.sourceType is string && data.sourceType in ['PHOTO', 'NOTES', 'MANUAL'] &&
             data.accentIndex is int && data.accentIndex >= 0 && data.accentIndex <= 5 &&
             data.cardCount is int && data.cardCount >= 0 && data.cardCount <= 5000 &&
             data.masteredCount is int && data.masteredCount >= 0 && data.masteredCount <= 5000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // Validation Helper: Flashcard
    function isValidFlashcard(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.deckId is string && isValidId(data.deckId) &&
             data.cardType is string && data.cardType in ['MULTIPLE_CHOICE', 'FILL_IN_BLANK', 'CONCEPT_EXPLAIN'] &&
             data.question is string && data.question.size() >= 1 && data.question.size() <= 1000 &&
             data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 1500 &&
             data.explanation is string && data.explanation.size() <= 1500 &&
             data.hint is string && data.hint.size() <= 300 &&
             data.options is list && data.options.size() <= 6 &&
             (data.options.size() == 0 || data.options[0] is string) &&
             data.correctOptionIndex is int && data.correctOptionIndex >= -1 && data.correctOptionIndex <= 5 &&
             data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 5.0 &&
             data.intervalDays is int && data.intervalDays >= 0 && data.intervalDays <= 36500 &&
             data.repetitions is int && data.repetitions >= 0 && data.repetitions <= 10000 &&
             data.dueAtMillis is int && data.dueAtMillis >= 0 &&
             data.lastReviewedAtMillis is int && data.lastReviewedAtMillis >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'streakDays', 'totalReviewed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'streakDays', 'totalReviewed', 'lastStudyDayKey', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action: Update study stats or display name
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'streakDays', 'totalReviewed', 'lastStudyDayKey', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /decks/{deckId} {
        allow get: if isOwner(userId) && isValidId(deckId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(deckId) &&
                         incoming().keys().hasAll(['userId', 'title', 'subject', 'description', 'sourceType', 'accentIndex', 'cardCount', 'masteredCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'subject', 'description', 'sourceType', 'accentIndex', 'cardCount', 'masteredCount', 'createdAt', 'updatedAt']) &&
                         isValidStudyDeck(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(deckId) &&
                         isValidStudyDeck(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Edit deck metadata
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'description', 'accentIndex', 'updatedAt']) ||
                           // Action: Sync deck counters after card mutation/review
                           incoming().diff(existing()).affectedKeys().hasOnly(['cardCount', 'masteredCount', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(deckId);
      }

      match /cards/{cardId} {
        allow get: if isOwner(userId) && isValidId(cardId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(cardId) &&
                         incoming().keys().hasAll(['userId', 'deckId', 'cardType', 'question', 'answer', 'explanation', 'hint', 'options', 'correctOptionIndex', 'easeFactor', 'intervalDays', 'repetitions', 'dueAtMillis', 'lastReviewedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'deckId', 'cardType', 'question', 'answer', 'explanation', 'hint', 'options', 'correctOptionIndex', 'easeFactor', 'intervalDays', 'repetitions', 'dueAtMillis', 'lastReviewedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidFlashcard(incoming(), userId) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/decks/$(incoming().deckId));

        allow update: if isOwner(userId) &&
                         isValidId(cardId) &&
                         isValidFlashcard(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().deckId == existing().deckId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Spaced-repetition review update
                           incoming().diff(existing()).affectedKeys().hasOnly(['easeFactor', 'intervalDays', 'repetitions', 'dueAtMillis', 'lastReviewedAtMillis', 'updatedAt']) ||
                           // Action: Edit card content
                           incoming().diff(existing()).affectedKeys().hasOnly(['cardType', 'question', 'answer', 'explanation', 'hint', 'options', 'correctOptionIndex', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(cardId);
      }
    }
  }
}
