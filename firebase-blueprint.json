{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile and spaced-repetition study streak statistics.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "Student display name (1-80 chars)."
        },
        "streakDays": {
          "type": "integer",
          "description": "Consecutive study days count."
        },
        "totalReviewed": {
          "type": "integer",
          "description": "Total flashcards reviewed across all sessions."
        },
        "lastStudyDayKey": {
          "type": "string",
          "description": "ISO date key YYYY-MM-DD of the most recent study session."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "displayName", "streakDays", "totalReviewed", "createdAt", "updatedAt"]
    },
    "StudyDeck": {
      "title": "StudyDeck",
      "description": "A flashcard deck forged from a whiteboard photo, handwritten notes, or manual entry.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Deck title (1-120 chars)."
        },
        "subject": {
          "type": "string",
          "description": "Academic subject or course tag (1-60 chars)."
        },
        "description": {
          "type": "string",
          "description": "Short AI-generated or user summary (0-400 chars)."
        },
        "sourceType": {
          "type": "string",
          "enum": ["PHOTO", "NOTES", "MANUAL"],
          "description": "Origin of the deck."
        },
        "accentIndex": {
          "type": "integer",
          "description": "Visual accent palette index (0-5)."
        },
        "cardCount": {
          "type": "integer",
          "description": "Total number of flashcards in this deck."
        },
        "masteredCount": {
          "type": "integer",
          "description": "Number of mastered flashcards in this deck."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "subject", "description", "sourceType", "accentIndex", "cardCount", "masteredCount", "createdAt", "updatedAt"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "An active-recall flashcard with SM-2 spaced-repetition scheduling metadata.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "deckId": {
          "type": "string",
          "description": "Parent StudyDeck document ID."
        },
        "cardType": {
          "type": "string",
          "enum": ["MULTIPLE_CHOICE", "FILL_IN_BLANK", "CONCEPT_EXPLAIN"],
          "description": "Active recall question format."
        },
        "question": {
          "type": "string",
          "description": "Prompt, cloze sentence, or conceptual question (1-1000 chars)."
        },
        "answer": {
          "type": "string",
          "description": "Canonical answer or model explanation (1-1500 chars)."
        },
        "explanation": {
          "type": "string",
          "description": "Detailed teaching rationale or step-by-step derivation (0-1500 chars)."
        },
        "hint": {
          "type": "string",
          "description": "Optional recall hint (0-300 chars)."
        },
        "options": {
          "type": "array",
          "description": "Multiple-choice answer options (up to 6 strings)."
        },
        "correctOptionIndex": {
          "type": "integer",
          "description": "0-based index of the correct MCQ option, or -1 for non-MCQ formats."
        },
        "easeFactor": {
          "type": "number",
          "description": "SM-2 ease factor (1.3 to 5.0)."
        },
        "intervalDays": {
          "type": "integer",
          "description": "Current SM-2 interval in days."
        },
        "repetitions": {
          "type": "integer",
          "description": "Consecutive successful recall count."
        },
        "dueAtMillis": {
          "type": "integer",
          "description": "Epoch milliseconds when the card is next due for review."
        },
        "lastReviewedAtMillis": {
          "type": "integer",
          "description": "Epoch milliseconds of the last review (0 if never reviewed)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "deckId", "cardType", "question", "answer", "explanation", "hint", "options", "correctOptionIndex", "easeFactor", "intervalDays", "repetitions", "dueAtMillis", "lastReviewedAtMillis", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student profile and daily study streak counters scoped to the authenticated user."
    },
    "/users/{userId}/decks/{deckId}": {
      "schema": { "$ref": "#/entities/StudyDeck" },
      "description": "User-owned flashcard decks synced with local Room SQLite cache."
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "User-owned flashcards with SM-2 spaced-repetition state synced across devices."
    }
  }
}
